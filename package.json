{
  "name": "ing-gutachten",
  "version": "1.0.0",
  "private": true,
  "description": "Website des Kfz-Sachverstaendigenbueros ING Gutachten, Hannover",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test tests/unit.test.cjs",
    "qa:crawl": "node scripts/crawl.mjs",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "create-owner": "tsx --env-file=.env scripts/create-owner.ts",
    "seed:demo": "tsx --env-file=.env scripts/seed-demo.ts",
    "test:db": "node --env-file=.env.test ./node_modules/prisma/build/index.js migrate deploy && node --env-file=.env.test --conditions=react-server --import tsx --test --test-concurrency=1 tests/db/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "framer-motion": "^11.18.2",
    "lenis": "^1.1.18",
    "next": "^15.1.6",
    "pg": "^8.23.1",
    "prisma": "^7.10.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "dotenv": "^18.0.6",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.25",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  }
}

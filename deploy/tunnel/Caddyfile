{
	admin off
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

:8080 {
	# Gilt für normale Antworten. Bewusst OHNE "-Server" in diesem Block: Caddy führt einen Header-Block
	# mit Feldlöschung verzögert aus, und das greift bei der selbst erzeugten 401 des Zugangsschutzes
	# nicht -> dort fehlten X-Robots-Tag & Co. (im Pruefmodus mit echtem Caddy 2.10.2 festgestellt).
	header {
		X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	# Einzige Ausnahme ohne Anmeldung: robots.txt (sagt Suchmaschinen: nichts indexieren)
	handle /robots.txt {
		header Content-Type "text/plain; charset=utf-8"
		respond <<TXT
			User-agent: *
			Disallow: /
			TXT 200
	}

	# Alles andere – jede Route, jede Methode – erst nach Basic Auth (Benutzer und Hash aus secrets/gate-auth.caddy)
	handle {
		import /etc/gate/auth.caddy
		reverse_proxy web:3000
	}

	# Fehlerantworten (401 der Sperre, 502 wenn ING Web nicht läuft, ...): "Server" entfernen.
	# Die übrigen Header setzt der normale Block oben auch hier; WWW-Authenticate bleibt erhalten.
	handle_errors {
		header -Server
		respond "{err.status_code} {err.status_text}"
	}
}

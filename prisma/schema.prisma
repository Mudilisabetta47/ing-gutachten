// =====================================================================
//  ING GUTACHTEN — Operating System · Datenmodell
//
//  Phase 1: Zugriff (User, Session, Rechte, Login-Drosselung), System
//  (Einstellungen) und Nachvollziehbarkeit (AuditLog).
//  Weitere Module (Leads, Fälle, Termine, CMS …) kommen phasenweise als
//  eigene Migrationen dazu – siehe docs/ARCHITEKTUR-OS.md.
//
//  Konventionen
//   - id        cuid (keine fortlaufenden Zahlen in URLs)
//   - Spalten   snake_case via @map, Tabellen via @@map
//   - Soft Delete (deletedAt) bei Geschäftsobjekten, die in der Historie
//     referenziert werden
//   - Index auf jedem Feld, nach dem die Oberfläche filtert/sortiert
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: Verbindung steht in prisma.config.ts, nicht im Schema.
}

// ---------------------------------------------------------------------
//  Zugriff
// ---------------------------------------------------------------------

enum Role {
  OWNER
  ADMIN
  OFFICE
  EXPERT
  ACCOUNTING
  CONTENT_MANAGER
  /// Prüfer: gibt Gutachten frei (Vier-Augen-Prinzip)
  REVIEWER
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  /// Argon2id-Hash. Niemals Klartext, niemals ein schneller Hash.
  passwordHash String  @map("password_hash")
  firstName    String  @map("first_name")
  lastName     String  @map("last_name")
  role         Role    @default(OFFICE)
  isActive     Boolean @default(true) @map("is_active")

  /// Brute-Force-Schutz pro Konto (zusätzlich zur Drosselung je IP in LoginAttempt).
  failedLogins       Int       @default(0) @map("failed_logins")
  lockedUntil        DateTime? @map("locked_until")
  lastLoginAt        DateTime? @map("last_login_at")
  /// Erzwingt Passwortwechsel (z. B. nach Anlage durch den Inhaber).
  mustChangePassword Boolean   @default(false) @map("must_change_password")

  /// Für TOTP vorbereitet, noch nicht aktiv.
  mfaSecret    String?   @map("mfa_secret")
  mfaEnabledAt DateTime? @map("mfa_enabled_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  employee    Employee?
  sessions    Session[]
  permissions UserPermission[]
  auditLogs   AuditLog[]

  leadsAssigned       Lead[]              @relation("LeadAssignee")
  locationId          String?             @map("location_id")
  location            Location?           @relation(fields: [locationId], references: [id])
  casesAssigned       Case[]              @relation("CaseExpert")
  casesCreated        Case[]              @relation("CaseCreator")
  appointments        Appointment[]       @relation("AppointmentExpert")
  appointmentsCreated Appointment[]       @relation("AppointmentCreator")
  mediaUploaded       Media[]
  damagesCreated      Damage[]
  notesAuthored       Note[]
  leadHistory         LeadStatusHistory[]
  caseHistory         CaseStatusHistory[]

  @@index([role, isActive])
  @@index([deletedAt])
  @@map("users")
}

/// Mitarbeiterprofil (1:1 zum Benutzer). Hier liegt, was ein Mitarbeiter ist,
/// nicht womit er sich anmeldet.
model Employee {
  id       String  @id @default(cuid())
  userId   String  @unique @map("user_id")
  initials String? // Kürzel für Fallnummern/Protokolle
  phone    String?
  /// Darf als Sachverständiger Fällen/Terminen zugewiesen werden.
  isExpert Boolean @default(false) @map("is_expert")
  jobTitle String? @map("job_title")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isExpert])
  @@map("employees")
}

model Session {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  /// Nur der SHA-256-Hash des Tokens. Wer die Datenbank liest, kann sich nicht anmelden.
  tokenHash  String    @unique @map("token_hash")
  ip         String?
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Abweichung vom Standardrechtesatz der Rolle – nach oben wie nach unten.
model UserPermission {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  permission String // z. B. "invoices.read" (siehe src/server/auth/permissions.ts)
  granted    Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
  @@map("user_permissions")
}

/// Fehlversuche der Anmeldung. In der Datenbank statt im Speicher, weil
/// Serverless-Instanzen keinen gemeinsamen Speicher haben. Gespeichert wird
/// nur ein Hash der E-Mail-Adresse und die IP – keine Passwörter.
model LoginAttempt {
  id        String   @id @default(cuid())
  ip        String
  emailHash String   @map("email_hash")
  success   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([ip, createdAt])
  @@index([emailHash, createdAt])
  @@map("login_attempts")
}

// ---------------------------------------------------------------------
//  System
// ---------------------------------------------------------------------

/// Konfiguration, die der Betrieb ohne Deployment ändern darf
/// (Fallnummern-Format, Dateilimits, Unternehmensdaten …). Werte sind kleine,
/// per Zod validierte JSON-Dokumente – keine Geheimnisse.
model SystemSetting {
  key         String   @id
  value       Json
  updatedById String?  @map("updated_by_id")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

// ---------------------------------------------------------------------
//  Nachvollziehbarkeit
// ---------------------------------------------------------------------

/// Fortlaufendes Protokoll. Einträge werden nie geändert oder gelöscht –
/// deshalb kein updatedAt/deletedAt. Änderungen stehen als Vorher/Nachher.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id")
  /// z. B. "auth.login", "user.create", "case.status_change"
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  summary    String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// =====================================================================
//  PHASE 2 — Pipeline: Inquiry → Lead → Kunde / Fahrzeug / Fall
// =====================================================================

enum LeadStatus {
  NEW
  CONTACTED
  APPOINTMENT_PENDING
  APPOINTMENT_SET
  CONVERTED
  CLOSED
  SPAM
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

/// Zustand der Datei: im privaten Speicher, nur per Mail zugestellt oder gar nicht gesichert.
enum AttachmentStatus {
  STORED
  MAIL_ONLY
  NOT_STORED
}

enum NoteKind {
  NOTE
  PHONE_CALL
}

enum CustomerType {
  PRIVATE
  BUSINESS
}

enum FuelType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
  PLUG_IN_HYBRID
  LPG
  CNG
  HYDROGEN
  OTHER
}

enum ServiceType {
  ACCIDENT_REPORT
  DAMAGE_REPORT
  VALUATION
  COST_ESTIMATE
  ACCIDENT_ANALYSIS
  RECONSTRUCTION
  OTHER
}

enum CaseStatus {
  NEW
  APPOINTMENT_PENDING
  APPOINTMENT_SET
  INSPECTED
  /// Neues Statusmodell (Phase 4): Kalkulation → Gutachten-Entwurf → Prüfung → Freigabe → Versand → Abrechnung
  CALCULATION
  REPORT_DRAFT
  REVIEW
  APPROVED
  SENT
  BILLING
  CLOSED
  CANCELLED
  /// Veraltet (Phase 2/3). Bleiben im Typ, damit alte Historie lesbar bleibt; werden nicht mehr vergeben.
  DOCUMENTS_MISSING
  IN_PROGRESS
  REPORT_READY
  REPORT_SENT
  INVOICED
}

/// Ursprüngliche Website-Anfrage. UNVERÄNDERLICH: ein Datenbank-Trigger verhindert UPDATEs
/// (Ausnahme: gezielte Anonymisierung nach DSGVO). Bearbeitet wird der Lead, nie die Inquiry.
/// Datensparsam: keine IP (nur ein gesalzener Hash zur Missbrauchserkennung), kein User-Agent.
model Inquiry {
  id             String   @id @default(cuid())
  receivedAt     DateTime @default(now()) @map("received_at")
  source         String   @default("website_form")
  formVersion    String   @map("form_version")
  reason         String
  vehicleKind    String   @map("vehicle_kind")
  name           String
  email          String
  phone          String
  location       String?
  licensePlate   String?  @map("license_plate")
  message        String?
  /// Einwilligung in die Verarbeitung der Anfrage – KEINE Marketing-Einwilligung.
  consentAt      DateTime @map("consent_at")
  privacyVersion String   @map("privacy_version")
  utmSource      String?  @map("utm_source")
  utmMedium      String?  @map("utm_medium")
  utmCampaign    String?  @map("utm_campaign")
  referrerHost   String?  @map("referrer_host")
  landingPath    String?  @map("landing_path")
  ipHash         String?  @map("ip_hash")

  lead        Lead?
  attachments InquiryAttachment[]

  @@index([receivedAt])
  @@index([ipHash, receivedAt])
  @@map("inquiries")
}

model InquiryAttachment {
  id         String           @id @default(cuid())
  inquiryId  String           @map("inquiry_id")
  /// "photo" | "registration"
  kind       String
  fileName   String           @map("file_name") // serverseitig vergeben, nie der Originalname
  mimeType   String           @map("mime_type")
  sizeBytes  Int              @map("size_bytes")
  sha256     String
  status     AttachmentStatus
  /// Zufälliger Schlüssel im privaten Speicher (nie erratbar, nie öffentlich).
  storageKey String?          @unique @map("storage_key")
  /// Wenn der private Dateispeicher aktiv war: die gespeicherte Datei (Media). Sonst bleibt es bei MAIL_ONLY/NOT_STORED.
  mediaId    String?          @unique @map("media_id")
  createdAt  DateTime         @default(now()) @map("created_at")

  inquiry Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  media   Media?  @relation(fields: [mediaId], references: [id])

  @@index([inquiryId])
  @@map("inquiry_attachments")
}

/// Bearbeitbarer Arbeitsvorgang. Bleibt nach der Umwandlung erhalten (Status CONVERTED + Verweise).
model Lead {
  id        String     @id @default(cuid())
  inquiryId String?    @unique @map("inquiry_id")
  status    LeadStatus @default(NEW)
  source    String     @default("website_form")

  // Arbeitskopie der Kontaktdaten (die Inquiry bleibt unangetastet)
  name             String
  email            String?
  phone            String?
  phoneNorm        String? @map("phone_norm")
  location         String?
  reason           String
  vehicleKind      String  @map("vehicle_kind")
  licensePlate     String? @map("license_plate")
  licensePlateNorm String? @map("license_plate_norm")
  message          String?

  assignedToId String?   @map("assigned_to_id")
  nextActionAt DateTime? @map("next_action_at")
  closedReason String?   @map("closed_reason")

  notificationStatus NotificationStatus @default(PENDING) @map("notification_status")
  notificationError  String?            @map("notification_error")
  notifiedAt         DateTime?          @map("notified_at")

  convertedAt         DateTime? @map("converted_at")
  convertedById       String?   @map("converted_by_id")
  convertedCustomerId String?   @map("converted_customer_id")
  convertedVehicleId  String?   @map("converted_vehicle_id")
  convertedCaseId     String?   @unique @map("converted_case_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  inquiry           Inquiry?            @relation(fields: [inquiryId], references: [id])
  assignedTo        User?               @relation("LeadAssignee", fields: [assignedToId], references: [id])
  convertedCustomer Customer?           @relation("LeadConvertedCustomer", fields: [convertedCustomerId], references: [id])
  convertedVehicle  Vehicle?            @relation("LeadConvertedVehicle", fields: [convertedVehicleId], references: [id])
  convertedCase     Case?               @relation("LeadConvertedCase", fields: [convertedCaseId], references: [id])
  history           LeadStatusHistory[]
  notes             Note[]

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([assignedToId, status])
  @@index([nextActionAt])
  @@index([notificationStatus])
  @@index([licensePlateNorm])
  @@index([phoneNorm])
  @@index([email])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "leads_name_trgm")
  @@map("leads")
}

model LeadStatusHistory {
  id         String      @id @default(cuid())
  leadId     String      @map("lead_id")
  fromStatus LeadStatus? @map("from_status")
  toStatus   LeadStatus  @map("to_status")
  actorId    String?     @map("actor_id")
  reason     String?
  createdAt  DateTime    @default(now()) @map("created_at")

  lead  Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id])

  @@index([leadId, createdAt])
  @@map("lead_status_history")
}

model Customer {
  id         String       @id @default(cuid())
  type       CustomerType @default(PRIVATE)
  company    String?
  firstName  String       @map("first_name")
  lastName   String       @map("last_name")
  email      String?
  phone      String?
  phoneNorm  String?      @map("phone_norm")
  street     String?
  postalCode String?      @map("postal_code")
  city       String?
  country    String       @default("DE")

  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  /// Archiv (Soft Delete). Echte Löschung/Anonymisierung folgt über ein eigenes Verfahren.
  deletedAt    DateTime? @map("deleted_at")
  anonymizedAt DateTime? @map("anonymized_at")

  vehicles       Vehicle[]
  cases          Case[]
  notes          Note[]
  convertedLeads Lead[]     @relation("LeadConvertedCustomer")
  documents      Document[]

  @@index([lastName, firstName])
  @@index([email])
  @@index([phone])
  @@index([phoneNorm])
  @@index([deletedAt])
  @@index([lastName(ops: raw("gin_trgm_ops"))], type: Gin, map: "customers_last_name_trgm")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "customers_email_trgm")
  @@index([company(ops: raw("gin_trgm_ops"))], type: Gin, map: "customers_company_trgm")
  @@map("customers")
}

model Vehicle {
  id                String    @id @default(cuid())
  customerId        String    @map("customer_id")
  manufacturer      String
  model             String
  variant           String?
  /// Anzeige, sauber formatiert (z. B. "H-AB 123").
  licensePlate      String?   @map("license_plate")
  /// Suchform: nur Buchstaben/Ziffern in Großbuchstaben ("HAB123").
  licensePlateNorm  String?   @map("license_plate_norm")
  vin               String?
  firstRegistration DateTime? @map("first_registration") @db.Date
  mileage           Int?
  fuelType          FuelType? @map("fuel_type")
  color             String?

  // Fahrzeugdaten (Phase 4 / Fahrzeugidentifikation) – alles optional, nie geschätzt
  hsn               String?
  tsn               String?
  hsnTsnId          String?           @map("hsn_tsn_id")
  engineName        String?           @map("engine_name")
  engineCode        String?           @map("engine_code")
  powerKw           Int?              @map("power_kw")
  powerHp           Int?              @map("power_hp")
  displacementCc    Int?              @map("displacement_cc")
  bodyStyle         String?           @map("body_style")
  driveType         String?           @map("drive_type")
  transmission      String?
  seats             Int?
  vehicleClass      String?           @map("vehicle_class")
  // Zulassung / Typgenehmigung (nur das, was belegt ist)
  approvalKind      TypeApprovalKind? @map("approval_kind")
  approvalNumber    String?           @map("approval_number")
  typeCode          String?           @map("type_code")
  variantCode       String?           @map("variant_code")
  versionCode       String?           @map("version_code")
  /// Ergebnis des letzten Abgleichs Fahrzeugschein ↔ Datenbank (Feld → Werte, Status)
  registrationCheck Json?             @map("registration_check")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  customer       Customer             @relation(fields: [customerId], references: [id])
  hsnTsnRecord   VehicleHsnTsn?       @relation(fields: [hsnTsnId], references: [id], onDelete: SetNull)
  cases          Case[]
  convertedLeads Lead[]               @relation("LeadConvertedVehicle")
  dataPoints     VehicleDataPoint[]
  dataHistory    VehicleDataHistory[]

  @@index([customerId])
  @@index([licensePlateNorm])
  @@index([vin])
  @@index([deletedAt])
  @@index([licensePlateNorm(ops: raw("gin_trgm_ops"))], type: Gin, map: "vehicles_plate_trgm")
  @@index([vin(ops: raw("gin_trgm_ops"))], type: Gin, map: "vehicles_vin_trgm")
  @@index([hsn, tsn])
  @@index([hsnTsnId])
  @@map("vehicles")
}

model Case {
  id          String      @id @default(cuid())
  /// z. B. ING-2026-000123 – vergeben über CaseCounter, race-condition-sicher.
  caseNumber  String      @unique @map("case_number")
  status      CaseStatus  @default(NEW)
  serviceType ServiceType @default(ACCIDENT_REPORT) @map("service_type")

  customerId       String  @map("customer_id")
  vehicleId        String  @map("vehicle_id")
  assignedExpertId String? @map("assigned_expert_id")
  createdById      String? @map("created_by_id")

  damageDate         DateTime? @map("damage_date") @db.Date
  accidentDate       DateTime? @map("accident_date") @db.Date
  inspectionLocation String?   @map("inspection_location")

  insuranceName        String? @map("insurance_name")
  insuranceClaimNumber String? @map("insurance_claim_number")
  opposingInsurance    String? @map("opposing_insurance")
  opposingClaimNumber  String? @map("opposing_claim_number")
  lawyer               String?
  repairShop           String? @map("repair_shop")

  description     String?
  cancelledReason String? @map("cancelled_reason")

  priority              CasePriority @default(NORMAL)
  claimType             ClaimType?   @map("claim_type")
  accidentPlace         String?      @map("accident_place")
  locationId            String?      @map("location_id")
  insuranceOrgId        String?      @map("insurance_org_id")
  lawyerOrgId           String?      @map("lawyer_org_id")
  workshopOrgId         String?      @map("workshop_org_id")
  dealershipOrgId       String?      @map("dealership_org_id")
  partnerOrgId          String?      @map("partner_org_id")
  insurancePolicyNumber String?      @map("insurance_policy_number")
  adjusterName          String?      @map("adjuster_name")
  adjusterPhone         String?      @map("adjuster_phone")
  adjusterEmail         String?      @map("adjuster_email")
  lawyerReference       String?      @map("lawyer_reference")
  /// Wichtige Info, die oben im Fall angeheftet bleibt („Kunde nur nach 16 Uhr erreichbar“)
  pinnedNote            String?      @map("pinned_note")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  closedAt  DateTime? @map("closed_at")
  deletedAt DateTime? @map("deleted_at")

  customer         Customer              @relation(fields: [customerId], references: [id])
  vehicle          Vehicle               @relation(fields: [vehicleId], references: [id])
  assignedExpert   User?                 @relation("CaseExpert", fields: [assignedExpertId], references: [id])
  createdBy        User?                 @relation("CaseCreator", fields: [createdById], references: [id])
  location         Location?             @relation(fields: [locationId], references: [id])
  insuranceOrg     Organization?         @relation("CaseInsurance", fields: [insuranceOrgId], references: [id])
  lawyerOrg        Organization?         @relation("CaseLawyer", fields: [lawyerOrgId], references: [id])
  workshopOrg      Organization?         @relation("CaseWorkshop", fields: [workshopOrgId], references: [id])
  dealershipOrg    Organization?         @relation("CaseDealership", fields: [dealershipOrgId], references: [id])
  partnerOrg       Organization?         @relation("CasePartner", fields: [partnerOrgId], references: [id])
  history          CaseStatusHistory[]
  notes            Note[]
  lead             Lead?                 @relation("LeadConvertedCase")
  appointments     Appointment[]
  inspections      Inspection[]
  damages          Damage[]
  calculations     Calculation[]
  valuationEntries ValuationEntry[]
  comparables      ValuationComparable[]
  photos           CasePhoto[]
  documents        Document[]

  @@index([status, createdAt])
  @@index([customerId])
  @@index([vehicleId])
  @@index([assignedExpertId, status])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([insuranceClaimNumber])
  @@index([priority, status])
  @@index([locationId])
  @@index([insuranceOrgId])
  @@index([caseNumber(ops: raw("gin_trgm_ops"))], type: Gin, map: "cases_number_trgm")
  @@map("cases")
}

/// Fallnummern-Zähler: eine Zeile je Jahr, hochgezählt mit einem einzigen atomaren
/// `INSERT … ON CONFLICT DO UPDATE … RETURNING` – keine Doppelvergabe bei parallelen Requests.
model CaseCounter {
  year      Int      @id
  lastValue Int      @default(0) @map("last_value")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("case_counters")
}

/// Fachliche Statushistorie (zusätzlich zum AuditLog).
model CaseStatusHistory {
  id         String      @id @default(cuid())
  caseId     String      @map("case_id")
  fromStatus CaseStatus? @map("from_status")
  toStatus   CaseStatus  @map("to_status")
  actorId    String?     @map("actor_id")
  reason     String?
  createdAt  DateTime    @default(now()) @map("created_at")

  case  Case  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id])

  @@index([caseId, createdAt])
  @@map("case_status_history")
}

/// Interne Notiz an genau EINEM Objekt (Lead, Kunde oder Fall) – per CHECK-Constraint erzwungen.
/// Nie für Kunden sichtbar. Nicht editierbar (Korrektur = neue Notiz).
model Note {
  id         String   @id @default(cuid())
  kind       NoteKind @default(NOTE)
  body       String
  authorId   String?  @map("author_id")
  leadId     String?  @map("lead_id")
  customerId String?  @map("customer_id")
  caseId     String?  @map("case_id")
  createdAt  DateTime @default(now()) @map("created_at")

  author   User?     @relation(fields: [authorId], references: [id])
  lead     Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id])
  case     Case?     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@index([customerId, createdAt])
  @@index([caseId, createdAt])
  @@map("notes")
}

// =====================================================================
//  PHASE 3 — Termine, Schäden, Fotos, Dokumente (privater Speicher)
// =====================================================================

enum AppointmentKind {
  INSPECTION
  REINSPECTION
  CONSULTATION
  OTHER
}

enum AppointmentStatus {
  PLANNED
  CONFIRMED
  DONE
  CANCELLED
  NO_SHOW
}

enum InspectionStatus {
  IN_PROGRESS
  FINISHED
}

enum MediaBucket {
  PRIVATE
  PUBLIC
}

enum ScanStatus {
  PENDING
  CLEAN
  FAILED
}

enum PhotoCategory {
  OVERVIEW
  FRONT
  REAR
  LEFT
  RIGHT
  DAMAGE
  PRIOR_DAMAGE
  DETAIL
  PLATE
  VIN
  ODOMETER
  INTERIOR
  ENGINE_BAY
  TYRES
  RIMS
  UNDERBODY
  DOCUMENTS
  REQUEST
  OTHER
}

enum DocumentCategory {
  REGISTRATION
  INSURANCE_LETTER
  POWER_OF_ATTORNEY
  ASSIGNMENT
  ASSIGNMENT_OF_CLAIM
  ACCIDENT_REPORT
  POLICE_REPORT
  WORKSHOP_DOCUMENT
  REPAIR_INVOICE
  RESIDUAL_OFFER
  CALCULATION
  INVOICE
  REPORT
  OTHER
}

enum DamageArea {
  FRONT
  REAR
  LEFT
  RIGHT
  ROOF
  UNDERBODY
  WHEELS
  GLASS
  INTERIOR
  OTHER
}

/// Termin eines Sachverständigen an einem Fall. Ein Gutachter kann nicht doppelt gebucht werden:
/// das erzwingt die Datenbank selbst (EXCLUDE-Constraint über Zeiträume), auch bei gleichzeitigen Anfragen.
model Appointment {
  id              String            @id @default(cuid())
  caseId          String            @map("case_id")
  expertId        String            @map("expert_id")
  kind            AppointmentKind   @default(INSPECTION)
  status          AppointmentStatus @default(PLANNED)
  startsAt        DateTime          @map("starts_at")
  endsAt          DateTime          @map("ends_at")
  location        String?
  notes           String?
  cancelledReason String?           @map("cancelled_reason")
  createdById     String?           @map("created_by_id")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  case       Case        @relation(fields: [caseId], references: [id])
  expert     User        @relation("AppointmentExpert", fields: [expertId], references: [id])
  createdBy  User?       @relation("AppointmentCreator", fields: [createdById], references: [id])
  inspection Inspection?

  @@index([expertId, startsAt, endsAt])
  @@index([startsAt])
  @@index([caseId, startsAt])
  @@index([status, startsAt])
  @@map("appointments")
}

/// Besichtigungsprotokoll zu einem Termin (mobiler Workflow).
model Inspection {
  id            String           @id @default(cuid())
  appointmentId String           @unique @map("appointment_id")
  caseId        String           @map("case_id")
  status        InspectionStatus @default(IN_PROGRESS)
  startedAt     DateTime         @default(now()) @map("started_at")
  finishedAt    DateTime?        @map("finished_at")
  weather       String?
  odometer      Int?
  note          String?
  startedById   String?          @map("started_by_id")

  appointment Appointment @relation(fields: [appointmentId], references: [id])
  case        Case        @relation(fields: [caseId], references: [id])

  @@index([caseId])
  @@map("inspections")
}

enum DamageKind {
  CURRENT
  PRIOR
  USAGE
  REPAIRED
  CHECK
}

enum DamageSeverity {
  LIGHT
  MEDIUM
  HEAVY
}

model Damage {
  id          String          @id @default(cuid())
  caseId      String          @map("case_id")
  area        DamageArea
  component   String
  damageType  String?         @map("damage_type")
  description String?
  repairKind  String?         @map("repair_kind")
  /// Bauteil-Kennung aus der visuellen Karte (z. B. "door_fl"); null = Freitext-Bauteil
  partId      String?         @map("part_id")
  /// Ansicht, in der der Schaden markiert wurde (z. B. "FRONT_LEFT")
  view        String?
  kind        DamageKind      @default(CURRENT)
  severity    DamageSeverity?
  /// Hinweis zum Vorschaden bzw. zur Prüfung
  priorNote   String?         @map("prior_note")
  sortOrder   Int             @default(0) @map("sort_order")
  createdById String?         @map("created_by_id")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  deletedAt   DateTime?       @map("deleted_at")

  case      Case        @relation(fields: [caseId], references: [id])
  createdBy User?       @relation(fields: [createdById], references: [id])
  photos    CasePhoto[]

  @@index([caseId, sortOrder])
  @@index([caseId, partId])
  @@map("damages")
}

/// Datei im Speicher. Der Schlüssel ist zufällig (nie Dateiname oder Fallnummer); der Original-Dateiname wird nicht gespeichert.
model Media {
  id           String      @id @default(cuid())
  storageKey   String      @unique @map("storage_key")
  thumbKey     String?     @unique @map("thumb_key")
  bucket       MediaBucket @default(PRIVATE)
  mimeType     String      @map("mime_type")
  sizeBytes    Int         @map("size_bytes")
  sha256       String
  scanStatus   ScanStatus  @default(PENDING) @map("scan_status")
  uploadedById String?     @map("uploaded_by_id")
  createdAt    DateTime    @default(now()) @map("created_at")
  deletedAt    DateTime?   @map("deleted_at")

  uploadedBy User?              @relation(fields: [uploadedById], references: [id])
  photo      CasePhoto?
  document   Document?
  inquiry    InquiryAttachment?

  @@index([createdAt])
  @@map("media")
}

model CasePhoto {
  id          String        @id @default(cuid())
  mediaId     String        @unique @map("media_id")
  caseId      String        @map("case_id")
  category    PhotoCategory @default(DAMAGE)
  title       String?
  description String?
  sortOrder   Int           @default(0) @map("sort_order")
  damageId    String?       @map("damage_id")
  createdAt   DateTime      @default(now()) @map("created_at")
  deletedAt   DateTime?     @map("deleted_at")

  media  Media   @relation(fields: [mediaId], references: [id])
  case   Case    @relation(fields: [caseId], references: [id])
  damage Damage? @relation(fields: [damageId], references: [id])

  @@index([caseId, sortOrder])
  @@index([caseId, category])
  @@map("case_photos")
}

model Document {
  id          String           @id @default(cuid())
  mediaId     String           @unique @map("media_id")
  caseId      String?          @map("case_id")
  customerId  String?          @map("customer_id")
  category    DocumentCategory @default(OTHER)
  title       String
  versionOfId String?          @map("version_of_id")
  createdById String?          @map("created_by_id")
  createdAt   DateTime         @default(now()) @map("created_at")
  deletedAt   DateTime?        @map("deleted_at")

  media     Media      @relation(fields: [mediaId], references: [id])
  case      Case?      @relation(fields: [caseId], references: [id])
  customer  Customer?  @relation(fields: [customerId], references: [id])
  versionOf Document?  @relation("DocumentVersions", fields: [versionOfId], references: [id])
  versions  Document[] @relation("DocumentVersions")

  @@index([caseId, createdAt])
  @@index([customerId, createdAt])
  @@map("documents")
}

// =====================================================================
//  PHASE 4 / M1 — Stammdaten, Standorte, Priorität, Schadenart
// =====================================================================

enum CasePriority {
  NORMAL
  HIGH
  URGENT
}

enum ClaimType {
  LIABILITY
  COMPREHENSIVE
  PARTIAL_COMPREHENSIVE
  OWN_DAMAGE
  VALUATION
  EVIDENCE
  OTHER
}

enum OrganizationKind {
  INSURANCE
  LAWYER
  WORKSHOP
  DEALERSHIP
  PARTNER
}

/// Niederlassung. Mitarbeiter und Fälle werden einem Standort zugeordnet.
model Location {
  id           String    @id @default(cuid())
  name         String
  street       String?
  postalCode   String?   @map("postal_code")
  city         String?
  phone        String?
  email        String?
  openingHours String?   @map("opening_hours")
  isDefault    Boolean   @default(false) @map("is_default")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  users User[]
  cases Case[]

  @@index([deletedAt])
  @@map("locations")
}

/// Versicherung, Kanzlei, Werkstatt, Autohaus oder Vermittler – eine Tabelle mit Art, damit Listen, Suche und Zuordnung zum Fall nur einmal gebaut werden.
model Organization {
  id          String           @id @default(cuid())
  kind        OrganizationKind
  name        String
  contactName String?          @map("contact_name")
  street      String?
  postalCode  String?          @map("postal_code")
  city        String?
  phone       String?
  fax         String?
  email       String?
  /// Schadenservice / zentrale Schadenmeldung
  claimsEmail String?          @map("claims_email")
  portalUrl   String?          @map("portal_url")
  notes       String?

  // Nur Werkstätten: Stundensätze (Cent je Stunde) und Zuschläge (Basispunkte: 1000 = 10 %)
  rateMechanicCents Int? @map("rate_mechanic_cents")
  rateBodyCents     Int? @map("rate_body_cents")
  rateElectricCents Int? @map("rate_electric_cents")
  ratePaintCents    Int? @map("rate_paint_cents")
  shippingCents     Int? @map("shipping_cents")
  partsMarkupBp     Int? @map("parts_markup_bp")
  paintMaterialBp   Int? @map("paint_material_bp")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  casesInsurance  Case[] @relation("CaseInsurance")
  casesLawyer     Case[] @relation("CaseLawyer")
  casesWorkshop   Case[] @relation("CaseWorkshop")
  casesDealership Case[] @relation("CaseDealership")
  casesPartner    Case[] @relation("CasePartner")

  @@index([kind, name])
  @@index([deletedAt])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "organizations_name_trgm")
  @@map("organizations")
}

/**
 * ============================================================ Fahrzeugdaten (HSN/TSN) ============================================================
 */

enum VehicleVerification {
  VERIFIED
  PARTIAL
  UNVERIFIED
  OUTDATED
  CONFLICT
}

enum ProviderLicense {
  UNKNOWN
  REVIEW_REQUIRED
  APPROVED
  LICENSED
  DISABLED
}

enum ImportJobStatus {
  PREVIEW
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

enum ImportRowOutcome {
  NEW
  EXISTS
  CONFLICT
  INVALID
  IMPORTED
}

enum ConflictStatus {
  OPEN
  MERGED
  KEPT_OWN
  TOOK_EXTERNAL
  MANUAL
}

enum TypeApprovalKind {
  EC_TYPE_APPROVAL
  ABE
  INDIVIDUAL
  UNKNOWN
}

model VehicleMake {
  id        String   @id @default(cuid())
  name      String   @unique
  /// Schreibweisen, die auf diesen Hersteller normalisiert werden (nie als Ersatz für den Originalwert)
  aliases   String[]
  createdAt DateTime @default(now()) @map("created_at")

  models  VehicleModel[]
  records VehicleHsnTsn[]

  @@map("vehicle_makes")
}

model VehicleModel {
  id        String   @id @default(cuid())
  makeId    String   @map("make_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  make        VehicleMake         @relation(fields: [makeId], references: [id])
  generations VehicleGeneration[]
  variants    VehicleVariant[]
  records     VehicleHsnTsn[]

  @@unique([makeId, name])
  @@map("vehicle_models")
}

model VehicleGeneration {
  id        String   @id @default(cuid())
  modelId   String   @map("model_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  model    VehicleModel     @relation(fields: [modelId], references: [id])
  variants VehicleVariant[]
  records  VehicleHsnTsn[]

  @@unique([modelId, name])
  @@map("vehicle_generations")
}

model VehicleVariant {
  id           String   @id @default(cuid())
  modelId      String   @map("model_id")
  generationId String?  @map("generation_id")
  name         String
  createdAt    DateTime @default(now()) @map("created_at")

  model      VehicleModel       @relation(fields: [modelId], references: [id])
  generation VehicleGeneration? @relation(fields: [generationId], references: [id])
  records    VehicleHsnTsn[]

  @@unique([modelId, name])
  @@map("vehicle_variants")
}

/// Eigene Fahrzeugdatenbank: ein Datensatz je HSN/TSN und Quelle (+ optionaler Quell-ID, falls die Quelle mehrere Varianten liefert).
model VehicleHsnTsn {
  id                  String    @id @default(cuid())
  hsn                 String
  tsn                 String
  manufacturerId      String?   @map("manufacturer_id")
  modelId             String?   @map("model_id")
  generationId        String?   @map("generation_id")
  variantId           String?   @map("variant_id")
  manufacturerNameRaw String?   @map("manufacturer_name_raw")
  vehicleNameRaw      String?   @map("vehicle_name_raw")
  manufacturer        String?
  model               String?
  generation          String?
  variant             String?
  bodyStyle           String?   @map("body_style")
  engineName          String?   @map("engine_name")
  engineCode          String?   @map("engine_code")
  fuelType            FuelType? @map("fuel_type")
  displacementCc      Int?      @map("displacement_cc")
  powerKw             Int?      @map("power_kw")
  powerHp             Int?      @map("power_hp")
  torqueNm            Int?      @map("torque_nm")
  transmission        String?
  driveType           String?   @map("drive_type")
  productionFrom      DateTime? @map("production_from") @db.Date
  productionTo        DateTime? @map("production_to") @db.Date
  typeApproval        String?   @map("type_approval")
  vehicleClass        String?   @map("vehicle_class")

  /// Herkunft: Provider-Schlüssel (HSN_TSN, KBA, DAT, VIN, MANUAL, IMPORT_FILE …)
  source              String
  sourceUrl           String?             @map("source_url")
  sourceRecordId      String              @default("") @map("source_record_id")
  sourceImportedAt    DateTime?           @map("source_imported_at")
  sourceLastCheckedAt DateTime?           @map("source_last_checked_at")
  sourceHash          String?             @map("source_hash")
  importerVersion     String?             @map("importer_version")
  /// Originalwerte der Quelle vor der Normalisierung (Leistung, Hubraum, Kraftstoff, Name …)
  rawData             Json?               @map("raw_data")
  verificationStatus  VehicleVerification @default(UNVERIFIED) @map("verification_status")
  /// Hilfsfeld für die schnelle Suche (kleingeschrieben, mit Zahlen- und Kurzformen)
  searchText          String              @default("") @map("search_text")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  makeRef       VehicleMake?          @relation(fields: [manufacturerId], references: [id])
  modelRef      VehicleModel?         @relation(fields: [modelId], references: [id])
  generationRef VehicleGeneration?    @relation(fields: [generationId], references: [id])
  variantRef    VehicleVariant?       @relation(fields: [variantId], references: [id])
  vehicles      Vehicle[]
  conflicts     VehicleDataConflict[]

  @@index([hsn, tsn])
  @@index([hsn])
  @@index([manufacturer])
  @@index([model])
  @@index([source])
  @@index([verificationStatus])
  @@index([deletedAt])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "vehicle_hsn_tsn_search_trgm")
  @@map("vehicle_hsn_tsn")
}

/// Provider-Verwaltung (keine Zugangsdaten hier – die gehören in Umgebungsvariablen).
model VehicleProvider {
  key               String          @id
  name              String
  /// internal | external
  kind              String
  description       String?
  enabled           Boolean         @default(false)
  licenseStatus     ProviderLicense @default(UNKNOWN) @map("license_status")
  autoLookup        Boolean         @default(false) @map("auto_lookup")
  massImport        Boolean         @default(false) @map("mass_import")
  /// Max. Anfragen pro Minute (hartes Limit, serverweit)
  rateLimitPerMin   Int             @default(10) @map("rate_limit_per_min")
  pausedUntil       DateTime?       @map("paused_until")
  pauseReason       String?         @map("pause_reason")
  lastConnectedAt   DateTime?       @map("last_connected_at")
  lastSuccessAt     DateTime?       @map("last_success_at")
  lastErrorAt       DateTime?       @map("last_error_at")
  lastErrorCategory String?         @map("last_error_category")
  requestCount      Int             @default(0) @map("request_count")
  errorCount        Int             @default(0) @map("error_count")
  /// nicht geheime Einstellungen (z. B. URL-Vorlagen)
  config            Json?
  notes             String?
  updatedById       String?         @map("updated_by_id")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  logs VehicleProviderLog[]
  jobs VehicleImportJob[]

  @@map("vehicle_providers")
}

/// Request-Protokoll je Provider – bewusst ohne personenbezogene Daten (kein Kennzeichen, keine FIN, keine Benutzer-IP).
model VehicleProviderLog {
  id            String   @id @default(cuid())
  providerKey   String   @map("provider_key")
  at            DateTime @default(now())
  requestType   String   @map("request_type")
  status        String
  durationMs    Int      @map("duration_ms")
  httpStatus    Int?     @map("http_status")
  recordsFound  Int?     @map("records_found")
  errorCategory String?  @map("error_category")

  provider VehicleProvider @relation(fields: [providerKey], references: [key])

  @@index([providerKey, at])
  @@map("vehicle_provider_logs")
}

model VehicleImportJob {
  id            String          @id @default(cuid())
  providerKey   String          @map("provider_key")
  mode          String
  label         String
  params        Json?
  status        ImportJobStatus @default(PREVIEW)
  total         Int             @default(0)
  countNew      Int             @default(0) @map("count_new")
  countExists   Int             @default(0) @map("count_exists")
  countConflict Int             @default(0) @map("count_conflict")
  countInvalid  Int             @default(0) @map("count_invalid")
  countImported Int             @default(0) @map("count_imported")
  /// Fortsetzungspunkt (Index der nächsten zu verarbeitenden Zeile)
  cursor        Int             @default(0)
  pausedUntil   DateTime?       @map("paused_until")
  message       String?
  createdById   String?         @map("created_by_id")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  finishedAt    DateTime?       @map("finished_at")

  provider VehicleProvider    @relation(fields: [providerKey], references: [key])
  rows     VehicleImportRow[]

  @@index([status])
  @@index([createdAt])
  @@map("vehicle_import_jobs")
}

model VehicleImportRow {
  id       String           @id @default(cuid())
  jobId    String           @map("job_id")
  position Int
  hsn      String?
  tsn      String?
  payload  Json
  outcome  ImportRowOutcome
  error    String?
  recordId String?          @map("record_id")

  job VehicleImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, position])
  @@index([jobId, outcome])
  @@map("vehicle_import_rows")
}

/// HSN/TSN identisch, Inhalt abweichend → nie überschreiben, sondern hier zur Entscheidung vorlegen.
model VehicleDataConflict {
  id             String         @id @default(cuid())
  recordId       String         @map("record_id")
  hsn            String
  tsn            String
  incoming       Json
  incomingSource String         @map("incoming_source")
  /// Liste der abweichenden Felder
  fields         String[]
  status         ConflictStatus @default(OPEN)
  resolvedById   String?        @map("resolved_by_id")
  resolvedAt     DateTime?      @map("resolved_at")
  createdAt      DateTime       @default(now()) @map("created_at")

  record VehicleHsnTsn @relation(fields: [recordId], references: [id])

  @@index([status])
  @@index([recordId])
  @@map("vehicle_data_conflicts")
}

/// Aktueller Stand je Fahrzeugfeld mit Herkunft (Datenherkunft) – Grundlage der Prioritätslogik.
model VehicleDataPoint {
  id            String              @id @default(cuid())
  vehicleId     String              @map("vehicle_id")
  field         String
  value         String?
  /// 100 manuell bestätigt · 80 offiziell/lizenziert · 70 VIN · 60 KBA · 50 HSN/TSN-Dritt · 20 unverifiziert
  priority      Int
  source        String
  sourceUrl     String?             @map("source_url")
  status        VehicleVerification @default(UNVERIFIED)
  retrievedAt   DateTime            @default(now()) @map("retrieved_at")
  confirmedById String?             @map("confirmed_by_id")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, field])
  @@map("vehicle_data_points")
}

/// Lückenlose Änderungshistorie der Fahrzeugdaten (wer, wann, alt, neu, Quelle).
model VehicleDataHistory {
  id        String   @id @default(cuid())
  vehicleId String   @map("vehicle_id")
  at        DateTime @default(now())
  actorId   String?  @map("actor_id")
  field     String
  oldValue  String?  @map("old_value")
  newValue  String?  @map("new_value")
  source    String
  note      String?

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, at])
  @@map("vehicle_data_history")
}

/**
 * ============================================================ Kalkulation ============================================================
 */

enum CalcStatus {
  DRAFT
  FINAL
}

enum CalcItemKind {
  PART
  LABOR
  PAINT
  MISC
}

/// Reparaturkalkulation eines Falls. Jede Fassung ist eine eigene Version; freigegebene (FINAL) Versionen sind unveränderlich.
model Calculation {
  id                String     @id @default(cuid())
  caseId            String     @map("case_id")
  version           Int
  status            CalcStatus @default(DRAFT)
  title             String?
  /// Mehrwertsteuer in Basispunkten (1900 = 19 %), 0 = ohne MwSt (vorsteuerabzugsberechtigt)
  vatBp             Int        @default(1900) @map("vat_bp")
  /// Minuten je Arbeitswert (AW); Standard 5 (12 AW = 1 Stunde)
  minutesPerAw      Int        @default(5) @map("minutes_per_aw")
  /// Stundensätze dieser Version (Kopie – spätere Änderungen an Stammdaten verändern alte Kalkulationen nicht)
  rateBodyCents     Int?       @map("rate_body_cents")
  rateMechanicCents Int?       @map("rate_mechanic_cents")
  rateElectricCents Int?       @map("rate_electric_cents")
  ratePaintCents    Int?       @map("rate_paint_cents")
  partsMarkupBp     Int        @default(0) @map("parts_markup_bp")
  paintMaterialBp   Int        @default(0) @map("paint_material_bp")
  note              String?
  /// Herkunft der Sätze (z. B. "Werkstatt: Beispiel (Demo)" oder "manuell")
  ratesSource       String?    @map("rates_source")
  createdById       String?    @map("created_by_id")
  finalizedById     String?    @map("finalized_by_id")
  finalizedAt       DateTime?  @map("finalized_at")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  case  Case              @relation(fields: [caseId], references: [id])
  items CalculationItem[]

  @@unique([caseId, version])
  @@index([caseId, status])
  @@map("calculations")
}

model CalculationItem {
  id             String       @id @default(cuid())
  calculationId  String       @map("calculation_id")
  /// stabile Kennung über Versionen hinweg (für den Versionsvergleich)
  ref            String
  position       Int
  kind           CalcItemKind
  /// BODY | MECHANIC | ELECTRIC (nur bei Arbeitslohn)
  laborCategory  String?      @map("labor_category")
  description    String
  partNumber     String?      @map("part_number")
  /// Bauteil der Schadenkarte bzw. verknüpfter Schaden (nur zur Orientierung)
  partId         String?      @map("part_id")
  damageId       String?      @map("damage_id")
  quantityX100   Int          @default(100) @map("quantity_x100")
  minutes        Int          @default(0)
  unitPriceCents Int          @default(0) @map("unit_price_cents")
  discountBp     Int          @default(0) @map("discount_bp")
  /// Herkunft des Preises (z. B. Händler, Werkstatt-KV, manuell) und Stand
  priceSource    String?      @map("price_source")
  priceDate      DateTime?    @map("price_date") @db.Date
  note           String?

  calculation Calculation @relation(fields: [calculationId], references: [id], onDelete: Cascade)

  @@index([calculationId, position])
  @@map("calculation_items")
}

/**
 * ============================================================ Bewertung ============================================================
 */

enum ValuationType {
  REPLACEMENT_VALUE
  RESIDUAL_VALUE
  RESIDUAL_OFFER
  DIMINISHED_VALUE
  USAGE_LOSS
  REPAIR_DURATION
  REPLACEMENT_DURATION
}

enum TaxMode {
  GROSS
  NET
  /// Differenzbesteuerung / ohne ausgewiesene MwSt – keine Umrechnung
  NONE
}

/// Bewertungswerte eines Falls. Einträge werden nie überschrieben: Änderungen = neuer Eintrag, der alte bleibt nachvollziehbar (zurückgezogen).
/// Je Typ ist höchstens ein Eintrag „gewählt“ und fließt in die Auswertung ein.
model ValuationEntry {
  id            String        @id @default(cuid())
  caseId        String        @map("case_id")
  type          ValuationType
  /// Bezeichnung, z. B. Bieter bei Restwertangeboten oder „Tagessatz Gruppe F“
  label         String?
  amountCents   Int?          @map("amount_cents")
  /// Tage (Nutzungsausfall, Dauer) bzw. Kilometer-/Zusatzangabe in `mileage`
  days          Int?
  taxMode       TaxMode       @default(GROSS) @map("tax_mode")
  /// Herkunft: MANUAL, VERGLEICH (aus Vergleichsfahrzeugen), ANGEBOT, oder Anbieterkürzel (DAT, Börse …) – nur was wirklich vorliegt
  source        String        @default("MANUAL")
  sourceRef     String?       @map("source_ref")
  referenceDate DateTime?     @map("reference_date") @db.Date
  validUntil    DateTime?     @map("valid_until") @db.Date
  note          String?
  selected      Boolean       @default(false)
  createdById   String?       @map("created_by_id")
  createdAt     DateTime      @default(now()) @map("created_at")
  withdrawnAt   DateTime?     @map("withdrawn_at")
  withdrawnById String?       @map("withdrawn_by_id")

  case Case @relation(fields: [caseId], references: [id])

  @@index([caseId, type])
  @@map("valuation_entries")
}

/// Vergleichsfahrzeuge (Inserate/Angebote) als Grundlage für den Wiederbeschaffungswert – nur Verweis und eingetragene Werte, keine automatische Übernahme.
model ValuationComparable {
  id          String    @id @default(cuid())
  caseId      String    @map("case_id")
  title       String
  priceCents  Int       @map("price_cents")
  mileage     Int?
  firstReg    DateTime? @map("first_reg") @db.Date
  location    String?
  sourceRef   String?   @map("source_ref")
  seenOn      DateTime? @map("seen_on") @db.Date
  note        String?
  included    Boolean   @default(true)
  createdById String?   @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  deletedAt   DateTime? @map("deleted_at")

  case Case @relation(fields: [caseId], references: [id])

  @@index([caseId])
  @@map("valuation_comparables")
}

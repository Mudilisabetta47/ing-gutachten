# ING Gutachten – STAGING (Vercel „Preview“-Umgebung bzw. eigenes Projekt). Vorlage ohne echte Werte.
# Staging = eigenes Supabase-Projekt + eigener privater Bucket + eigene Schlüssel. NICHTS mit Produktion teilen.
# Prüfen vor jedem Deployment:  npm run preflight -- staging --env-file <lokale, gitignorierte Kopie>
ING_ENV=staging
SITE_URL=https://staging.ing-gutachten.example      # eigene (nicht öffentlich beworbene) Adresse, https

DATABASE_URL=                  # TRANSACTION-POOLER (aws-…pooler.supabase.com:6543, Benutzer postgres.<ref>) – Supabase-STAGING, Transaction-Pooler (Port 6543), ?sslmode=require
# Migrationen/Sicherung (nur in der lokalen Shell, nie in Vercel): BACKUP_DATABASE_URL = direkte Verbindung oder Session-Pooler (Port 5432)
DATABASE_CA_CERT=              # optional, empfohlen
DATABASE_POOL_MAX=3

STORAGE_DRIVER=s3
# Supabase Storage: Endpunkt und Region aus Dashboard → Storage → Settings → „S3 Connection“ kopieren; Zugriffsschlüssel dort erzeugen (nie im Chat)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET_PRIVATE=ing-staging-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
STORAGE_ENCRYPTION_KEY=        # npm run secrets:generate (eigener Wert, nicht aus Produktion)
MFA_ENCRYPTION_KEY=            # eigener Wert
IP_HASH_SALT=
HEALTH_TOKEN=
MONITOR_SECRET=                # Bearer-Geheimnis für /api/monitor/check (externer Prüfdienst)
BACKUP_ENCRYPTION_KEY=

# Mail: in Staging NUR an freigegebene Testadressen (Pflicht, sonst verweigert die App den Versand)
MAIL_PROVIDER=brevo
BREVO_API_KEY=
MAIL_FROM=
MAIL_TO=
MAIL_ALLOWED_RECIPIENTS=       # z. B. test@ihre-domain.de,@ihre-domain.de

ALERT_EMAIL_TO=                # Empfänger für Fehler-/Störungs-Mails (höchstens 3, kommagetrennt); in Staging auch in MAIL_ALLOWED_RECIPIENTS
ALERT_WEBHOOK_URL=             # https-Webhook (Slack/Teams/ntfy/Uptime-Dienst)

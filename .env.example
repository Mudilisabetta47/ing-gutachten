# ---------------------------------------------------------------
# ING Gutachten – Umgebungsvariablen (Vorlage, KEINE echten Werte)
# Lokal: Datei nach .env.local kopieren. In Vercel: Settings →
# Environment Variables (Production UND Preview).
# ---------------------------------------------------------------

# Produktivdomain. In Production NICHT leer lassen bzw. nicht auf *.vercel.app setzen.
SITE_URL=https://ing-gutachten.de

# --- Anfrageformular / Foto-Versand (serverseitig, nie im Browser) ---
# Provider: "brevo" oder "resend". Ohne Konfiguration antwortet die API ehrlich mit 503.
# "dry-run" (nur Tests): validiert alles, versendet NICHTS, die Antwort enthält dryRun:true.
#   - Vercel Production: dry-run ist VERBOTEN → Konfigurationsfehler (503, Log-Eintrag)
#   - Vercel Preview:    dry-run nur mit ALLOW_PREVIEW_DRY_RUN=true
#   - lokal:             nur mit `next dev`
MAIL_PROVIDER=brevo

# Nur für Vercel *Preview* (Environment "Preview" in den Vercel-Einstellungen), um den Formularfluss
# ohne echten Versand zu testen. In Production NIE setzen.
# ALLOW_PREVIEW_DRY_RUN=true

# Brevo (https://developers.brevo.com/reference/sendtransacemail)
BREVO_API_KEY=

# Resend (https://resend.com/docs/api-reference/emails/send-email)
RESEND_API_KEY=

# Absender (Domain muss beim Provider verifiziert sein) und Empfänger der Anfragen
MAIL_FROM=
MAIL_FROM_NAME=ING Gutachten Website
MAIL_TO=

# --- Umgebung ----------------------------------------------------------------------
# development | test | staging | production. Ohne Angabe: Vercel production → production, Vercel preview → staging, sonst development.
# In staging/production gelten strengere Regeln (Demo-Konten gesperrt, Dateispeicher nur verschlüsselt, Mail nur an Positivliste in staging).
# Vorlagen: .env.staging.example / .env.production.example · Prüfung: npm run preflight -- <staging|production>
# ING_ENV=development

# --- Datenbank (Operating System, ab Phase 1) -------------------------------
# PostgreSQL 15+. Lokal z. B. Postgres.app:
#   postgresql://BENUTZER@localhost:5432/ing_os_dev?schema=public
# Produktion: verwaltete DB in der EU (z. B. Neon Frankfurt), SSL: ?sslmode=require
# Ohne DATABASE_URL läuft die öffentliche Website unverändert; /admin zeigt "nicht eingerichtet".
DATABASE_URL=
# Produktion (Supabase, siehe docs/BETRIEB.md): Transaction-Pooler-URL der App; Migrationen laufen mit der direkten URL (nur in der Shell setzen).
# DATABASE_CA_CERT=        # optional: PEM des Datenbank-Zertifikats (volle TLS-Prüfung)
# DATABASE_POOL_MAX=3      # Serverless: wenige Verbindungen je Instanz

# --- Sitzungen / Anmeldung (optional, Defaults siehe docs/ARCHITEKTUR-OS.md §9) ---
# SESSION_HOURS=12
# SESSION_MAX_DAYS=7
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCK_MINUTES=15

# --- Privater Dateispeicher (ab Phase 3) ------------------------------------
# STORAGE_DRIVER=s3        # s3 (Produktion) | local (nur Entwicklung/Tests; auf Vercel verboten)
# STORAGE_LOCAL_DIR=       # optional, Standard: .data/private (gitignored)
# S3_ENDPOINT=             # z. B. https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET_PRIVATE=
# S3_BUCKET_PUBLIC=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Anfrage-Speicherung (Phase 2) --------------------------------------------
# Salz für den Missbrauchs-Hash der IP-Adresse (HMAC-SHA256, gekürzt). Mindestens 16 Zeichen, zufällig,
# geheim. OHNE dieses Salz wird gar keine IP-Ableitung gespeichert (datensparsam). Zufallswert erzeugen:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
IP_HASH_SALT=

# --- Zwei-Faktor-Anmeldung (TOTP) ------------------------------------------------
# Schlüssel (mind. 32 Zeichen, zufällig, geheim), mit dem die 2FA-Geheimnisse in der Datenbank verschlüsselt werden.
# OHNE ihn ist die Einrichtung in Produktion gesperrt. Sicher getrennt von der Datenbank-Sicherung aufbewahren
# (siehe docs/BACKUP-WIEDERHERSTELLUNG.md). Erzeugen:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MFA_ENCRYPTION_KEY=

# Schlüsselwechsel: bisheriger Schlüssel (nur während der Umstellung), danach  npm run mfa:rotate / npm run storage:migrate -- --apply
# MFA_ENCRYPTION_KEY_PREVIOUS=

# --- Verschlüsselung des Dateispeichers (Fotos, Dokumente, PDFs; AES-256-GCM, Anwendungsebene) -------------------
# Pflicht in staging/production (ohne Schlüssel wird dort nichts gespeichert). Erzeugen: npm run secrets:generate
STORAGE_ENCRYPTION_KEY=
# STORAGE_ENCRYPTION_KEY_PREVIOUS=

# --- Sicherung (npm run backup) ---------------------------------------------------------------------------------
# Schlüssel für die verschlüsselte Sicherung (Datenbank-Dump + Manifest-Siegel). Pflicht in staging/production. Getrennt vom Rest aufbewahren!
BACKUP_ENCRYPTION_KEY=
# Direkte (nicht gepoolte) Datenbank-Verbindung nur für pg_dump; sonst wird DATABASE_URL genutzt. Ausgabeordner / Aufbewahrung:
# BACKUP_DATABASE_URL=
# BACKUP_DIR=backups
# BACKUP_KEEP=14

# --- Überwachung ---------------------------------------------------------------------------------------------------------
# https-Webhook für Fehlermeldungen (Slack/Teams/ntfy/…); ohne ihn nur strukturierte Log-Zeilen
ALERT_WEBHOOK_URL=
# Token für /api/health (Header „Authorization: Bearer <Token>“): Detailansicht Datenbank, Speicher, Mail – ohne Token nur ok/degraded
HEALTH_TOKEN=

# --- E-Mail-Schutz -------------------------------------------------------------------------------------------------------
# Kommagetrennt: erlaubte Empfänger (Adressen oder @domain). In staging Pflicht; blockierte Mails werden protokolliert, nicht gesendet.
MAIL_ALLOWED_RECIPIENTS=

# ING Gutachten – PRODUKTION (Vercel „Production“). Vorlage ohne echte Werte.
# Eigenes Supabase-Projekt, eigener privater Bucket, eigene Schlüssel. Prüfen:  npm run preflight -- production --compare <staging-Datei>
ING_ENV=production
SITE_URL=https://ing-gutachten.de

DATABASE_URL=                  # TRANSACTION-POOLER (aws-…pooler.supabase.com:6543, Benutzer postgres.<ref>) – Supabase-PRODUKTION, Transaction-Pooler (Port 6543), ?sslmode=require
# Migrationen/Sicherung (nur in der lokalen Shell, nie in Vercel): BACKUP_DATABASE_URL = direkte Verbindung oder Session-Pooler (Port 5432)
DATABASE_CA_CERT=
DATABASE_POOL_MAX=3

STORAGE_DRIVER=s3
# Supabase Storage: Endpunkt und Region aus Dashboard → Storage → Settings → „S3 Connection“ kopieren; Zugriffsschlüssel dort erzeugen (nie im Chat)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET_PRIVATE=ing-prod-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
STORAGE_ENCRYPTION_KEY=        # nur in Produktion; zusätzlich getrennt im Passwortmanager hinterlegen
MFA_ENCRYPTION_KEY=
IP_HASH_SALT=
HEALTH_TOKEN=
MONITOR_SECRET=                # Bearer-Geheimnis für /api/monitor/check (externer Prüfdienst)
BACKUP_ENCRYPTION_KEY=

MAIL_PROVIDER=brevo
BREVO_API_KEY=
MAIL_FROM=
MAIL_TO=
# MAIL_ALLOWED_RECIPIENTS bleibt in Produktion leer (sonst werden echte Kunden-Mails blockiert)

ALERT_EMAIL_TO=                # Empfänger für Fehler-/Störungs-Mails (höchstens 3, kommagetrennt)
ALERT_WEBHOOK_URL=

# Niemals in Produktion setzen: ALLOW_REMOTE_DB, ALLOW_PREVIEW_DRY_RUN, STORAGE_LOCAL_DIR, ALLOW_PRODUCTION_BOOTSTRAP (nur einmalig beim Anlegen des Inhabers)
